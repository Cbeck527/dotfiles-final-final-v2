diff --git a/modules/httputil/httputil.go b/modules/httputil/httputil.go
index e0dbe3a..a26ad9f 100644
--- a/modules/httputil/httputil.go
+++ b/modules/httputil/httputil.go
@@ -36,3 +36,33 @@ func (t *userAgentTransport) RoundTrip(req *http.Request) (*http.Response, error
 	req.Header.Set("User-Agent", UserAgent())
 	return t.base.RoundTrip(req)
 }
+
+// WithHeaders wraps an http.RoundTripper to add extra headers to every request.
+// Headers set here will not override headers already present on the request.
+func WithHeaders(base http.RoundTripper, headers map[string]string) http.RoundTripper {
+	if len(headers) == 0 {
+		return base
+	}
+	if base == nil {
+		base = http.DefaultTransport
+	}
+	h := make(map[string]string, len(headers))
+	for k, v := range headers {
+		h[k] = v
+	}
+	return &headerTransport{base: base, headers: h}
+}
+
+type headerTransport struct {
+	base    http.RoundTripper
+	headers map[string]string
+}
+
+func (t *headerTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	for key, value := range t.headers {
+		if req.Header.Get(key) == "" {
+			req.Header.Set(key, value)
+		}
+	}
+	return t.base.RoundTrip(req)
+}
