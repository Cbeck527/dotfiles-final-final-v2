{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nix-config-installer",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "dotfiles.cmb.software", "custom_domain": true }
  ],
  "rules": [
    { "type": "Text", "globs": ["**/*.sh"], "fallthrough": true }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
