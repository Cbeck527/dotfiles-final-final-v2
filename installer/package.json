{
  "name": "nix-config-installer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev --local",
    "types": "wrangler types",
    "typecheck": "pnpm types && tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "check": "pnpm typecheck && pnpm test && shellcheck src/bootstrap.sh && wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "wrangler": "4.132.0"
  }
}
